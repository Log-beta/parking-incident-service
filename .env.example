# Incident Reports Service
PORT=3003
INSTANCE_ID=incidents-3003

# AWS / Floci
AWS_REGION=us-east-1
AWS_PROFILE=floci
DYNAMODB_ENDPOINT=http://localhost:4566

# DynamoDB tables
INCIDENT_REPORTS_TABLE=IncidentReports
INCIDENT_DUPLICATE_KEYS_TABLE=IncidentDuplicateKeys
PERMIT_VERIFICATION_LOGS_TABLE=PermitVerificationLogs

# Rate limiting
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# Shared Cognito authentication
AUTH_MODE=cognito
COGNITO_REGION=us-east-1
COGNITO_ENDPOINT=http://localhost:4566
COGNITO_USER_POOL_ID=us-east-1_eeb9e71f0
COGNITO_CLIENT_ID=5a15c7e27bfe4e9e90440266df
COGNITO_ISSUER=http://floci:4566/us-east-1_eeb9e71f0
COGNITO_JWKS_URL=http://localhost:4566/us-east-1_eeb9e71f0/.well-known/jwks.json

# Private identity mapping
COGNITO_USERS_FILE=.local/cognito-users.json
# Alternatively use COGNITO_USERS_JSON through Secrets Manager.

# Allocation service integration
ALLOCATION_URL=http://localhost:3001
INTERNAL_TOKEN=

# Secrets Manager configuration
SECRETS_MANAGER_ENDPOINT=http://localhost:4566
RUNTIME_SECRET_ID=parking/incidents/runtime

# Cloudflare Turnstile backend configuration
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
TURNSTILE_EXPECTED_ACTION=incident_submit
